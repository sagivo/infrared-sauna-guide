---
import type { MowerModel } from "../data/models";
import { accessoriesFor, KIND_LABEL } from "../data/accessories";
import { AFFILIATE_REL, amazonLink } from "../lib/amazon";

interface Props {
  model: MowerModel;
}
const { model: m } = Astro.props;
const rows = accessoriesFor(m.id);
---

{rows.length > 0 && (
  <section class="acc" aria-labelledby="accessories">
    <h2 id="accessories">Accessories for the {m.shortName}</h2>
    <p class="acc-intro">
      Hand-picked add-ons sold on Amazon that work with any infrared sauna. Check the listing before you buy.
    </p>
    <ul class="acc-list">
      {rows.map((a) => (
        <li class="acc-row">
          <span class="acc-kind">{KIND_LABEL[a.kind]}</span>
          <div class="acc-main">
            <strong>{a.name}</strong>
            <span class="acc-tag">{a.brand} · {a.fits.includes("universal") ? "Universal fit" : "Model-specific"}</span>
            <p>{a.why}</p>
          </div>
          <div class="acc-buy">
            <a class="btn buy btn-xs" href={amazonLink(a.query)} rel={AFFILIATE_REL} target="_blank">Check price</a>
          </div>
        </li>
      ))}
    </ul>
    <p class="fine">Compatibility checked October 2026. More in our <a href="/accessories/">sauna accessories guide</a>.</p>
  </section>
)}
