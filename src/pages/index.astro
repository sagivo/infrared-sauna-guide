---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import PostCard from "../components/PostCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import ProductImage from "../components/ProductImage.astro";
import BuyButton from "../components/BuyButton.astro";
import StickyCta from "../components/StickyCta.astro";
import PriceTier from "../components/PriceTier.astro";
import { SITE_NAME, SITE_DESCRIPTION } from "../lib/site";
import { MODELS, getModel, priceTier } from "../data/models";
import { getPosts } from "../lib/posts";
import { websiteLd, faqLd, itemListLd } from "../lib/schema";
import { HOME_PICKS } from "../data/picks";

const posts = await getPosts();
const latest = [...posts].sort(
  (a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf()
);
const guides = latest.filter((p) => p.data.category !== "best").slice(0, 6);
const topModels = [...MODELS].sort((a, b) => b.score - a.score).slice(0, 6);
const picks = HOME_PICKS.map((p) => ({ ...p, model: getModel(p.id) }));

const top = picks[0].model;
// Award colours for the four homepage picks (overall, value, small spaces, portable).
const ACCENTS = ["#fbbf24", "#fb923c", "#f87171", "#fde68a"];

// Each need tile shows the #1 pick from its guide, so readers can buy straight from the homepage.
const needTypes = [
  { slug: "best-infrared-sauna-under-1000", icon: "💵", title: "Under $1,000", text: "Real infrared heat without the cabin price: blankets and budget picks." },
  { slug: "low-emf-infrared-sauna-guide", icon: "🛡️", title: "Low EMF", text: "What milligauss numbers mean and which cabins publish the lowest." },
  { slug: "how-to-choose-infrared-sauna", icon: "📏", title: "Small spaces", text: "Cabins that fit spare rooms, large closets and low basements." },
  { slug: "1-person-vs-2-person-infrared-sauna", icon: "👥", title: "Solo or shared?", text: "1-person vs 2-person cabins: footprint, cost and comfort." },
  { slug: "infrared-sauna-electrical-requirements", icon: "🔌", title: "Electrical setup", text: "15A plug-and-play vs 20A circuits, and what an electrician costs." },
  { slug: "indoor-vs-outdoor-infrared-sauna", icon: "🏠", title: "Where to put it", text: "Basement, bathroom, garage or bedroom — placement that works." },
].map((y) => {
  const first = posts.find((p) => p.id === y.slug)?.data.picks?.[0];
  return { ...y, href: `/posts/${y.slug}/`, pick: first ? getModel(first.id) : undefined };
});

const faq = [
  {
    q: "What is the best infrared sauna in 2026?",
    a: `It depends on your space and budget. Our top-rated pick overall is the ${picks[0].model.name}. For tight budgets, a 2-person value cabin or a sauna blanket gets you real infrared heat for far less. Our best infrared saunas guide ranks them all.`,
  },
  {
    q: "Are infrared saunas on Amazon any good?",
    a: "Yes — with a caveat. The big editorial review sites mostly cover $3,000–$9,000 direct-sale brands, so Amazon's $400–$2,500 tier gets little professional coverage. That's exactly the gap we cover: the same hemlock cabins, carbon heaters and low-EMF panels, researched model by model.",
  },
  {
    q: "How much does a home infrared sauna cost?",
    a: "Cabins on Amazon run about $700–$2,800. Budget $300–$600 more if you need an electrician to run a dedicated circuit, and roughly $0.20 per session in electricity. Our cost calculator totals it for your numbers.",
  },
  {
    q: "Do infrared saunas need special wiring?",
    a: "Almost all of them plug into a standard 120V/15A outlet — no special wiring. The one exception on our list is the HeatWave Santa Fe corner unit, which needs a 120V/20A circuit.",
  },
];

const jsonLd = [websiteLd(), itemListLd("Top infrared saunas of 2026", picks.map((p) => p.model)), faqLd(faq)];
---

<BaseLayout
  title={`${SITE_NAME}: Best Home Infrared Saunas of 2026, Compared`}
  description={SITE_DESCRIPTION}
  jsonLd={jsonLd}
  hidePromo
>
  <section class="hero">
    <div class="wrap wide hero-grid">
      <div>
        <span class="hero-kicker"><span class="dot" aria-hidden="true"></span>Updated October 2026</span>
        <h1>The best home infrared saunas of 2026, <em>ranked.</em></h1>
        <p class="lead">
          We compared {MODELS.length} infrared saunas on heaters, EMF, build quality
          and price — including the sub-$2,500 Amazon tier the big review sites ignore —
          so you can skip the research and start sweating.
        </p>
        <div class="cta-row">
          <a class="btn btn-lg" href="/posts/best-infrared-saunas-2026/">See the ranking</a>
          <a class="btn secondary btn-lg" href="/tools/space-fit-checker/">Will it fit my room?</a>
        </div>
        <div class="hero-proof">
          <div><strong>{MODELS.length}</strong><span>saunas compared</span></div>
          <div><strong>{new Set(MODELS.map((m) => m.brand)).size}</strong><span>brands compared</span></div>
          <div><strong>$0.20</strong><span>typical cost per session</span></div>
        </div>
      </div>

      <aside class="spotlight" aria-label="Our top pick">
        <div class="sp-ribbon"><span>🏆 #1 {picks[0].label}</span><span>2026</span></div>
        <div class="sp-media"><ProductImage model={top} size={260} eager /></div>
        <div class="sp-body">
          <h2 class="sp-name"><a href={`/saunas/${top.id}/`}>{top.name}</a></h2>
          <div class="sp-meta">
            <span class="ring" style={`--v:${top.score * 10}`}><span>{top.score.toFixed(1)}</span></span>
            <span class="ring-label"><strong>Guide score</strong>out of 10</span>
            <span class="sp-price"><PriceTier model={top} label={false} /><small>{priceTier(top).label} price tier</small></span>
          </div>
          <ul class="sp-points">{top.pros.slice(0, 3).map((p) => <li>{p}</li>)}</ul>
          <BuyButton model={top} size="lg" block />
          <div class="sp-links">
            <a href={`/saunas/${top.id}/`}>Read the review →</a>
            <a href="/saunas/">Compare all {MODELS.length}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="trust-bar" aria-label="Why readers trust us">
    <ul>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>Commissions never decide rankings</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs cross-checked across sources</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>Specs refreshed October 2026</li>
      <li><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 19V9M12 19V5M19 19v-7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>Free sizing &amp; cost calculators</li>
    </ul>
  </section>

  <div class="wrap wide">
    <div class="section-head">
      <div>
        <span class="eyebrow">Editor's picks</span>
        <h2 class="section-title">The 4 infrared saunas we'd buy in 2026</h2>
        <p class="section-sub">One clear winner for each kind of buyer. Tap a card for the full review.</p>
      </div>
      <a class="section-link" href="/posts/best-infrared-saunas-2026/">Full ranking →</a>
    </div>
    <div class="tp-grid four">
      {picks.map((p, i) => <ProductCard model={p.model} label={p.label} featured={i === 0} accent={ACCENTS[i]} />)}
    </div>
    <p class="swipe-hint">Swipe for more picks →</p>

    <div class="section-head">
      <div>
        <span class="eyebrow">Shop by need</span>
        <h2 class="section-title">Best infrared sauna for your situation</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="yard-grid">
      {needTypes.map((y) => (
        <div class="yard">
          <div class="yard-top">
            <div class="yard-icon" aria-hidden="true">{y.icon}</div>
            <h3><a href={y.href}>{y.title}</a></h3>
          </div>
          <p>{y.text}</p>
          {y.pick && (
            <div class="yard-pick">
              <span><small>Top pick</small><strong>{y.pick.shortName}</strong></span>
              <BuyButton model={y.pick} label="Check price" size="sm" />
            </div>
          )}
          <span class="go">See every pick</span>
        </div>
      ))}
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Side by side</span>
        <h2 class="section-title">Highest-rated models at a glance</h2>
      </div>
      <a class="section-link" href="/saunas/">Compare all {MODELS.length} →</a>
    </div>
    <ComparisonTable models={topModels} />

    <div class="section-head">
      <div>
        <span class="eyebrow">Free tools</span>
        <h2 class="section-title">Don't guess. Calculate.</h2>
      </div>
      <a class="section-link" href="/tools/">All tools →</a>
    </div>
    <div class="tool-grid">
      <a class="tool-card" href="/tools/cost-calculator/">
        <div class="tool-icon">🔥</div>
        <h3>Sauna Cost Calculator</h3>
        <p>True 5-year cost of ownership: purchase, electrical work and running costs.</p>
        <span class="go">Do the math</span>
      </a>
      <a class="tool-card" href="/tools/space-fit-checker/">
        <div class="tool-icon">📐</div>
        <h3>Space-Fit Checker</h3>
        <p>Enter your room's dimensions and see which cabins fit, clearance included.</p>
        <span class="go">Check my room</span>
      </a>
      <a class="tool-card" href="/tools/session-cost/">
        <div class="tool-icon">⚡</div>
        <h3>Session Cost Estimator</h3>
        <p>What one sauna session costs in electricity — per session, month and year.</p>
        <span class="go">Estimate a session</span>
      </a>
    </div>

    <div class="section-head">
      <div>
        <span class="eyebrow">Buying advice</span>
        <h2 class="section-title">Comparisons &amp; guides</h2>
      </div>
      <a class="section-link" href="/guides/">All guides →</a>
    </div>
    <div class="post-grid">
      {guides.map((post) => <PostCard post={post} />)}
    </div>

    <section class="strip" aria-label="Why trust this guide">
      <div>
        <h2>Research you can actually check.</h2>
        <p>We earn a commission when you buy through our links, but it never changes which sauna we recommend.</p>
        <a class="btn" href="/how-we-research/">How we score saunas</a>
      </div>
      <div class="strip-items">
        <div><div class="n">01</div><h3>The ignored tier, covered</h3><p>Big review sites cover $3k+ direct-sale brands. We research the $400–$2,500 Amazon tier they skip.</p></div>
        <div><div class="n">02</div><h3>Specs, cross-checked</h3><p>Heater counts, wattage and EMF claims verified across manufacturers, reviews and owner reports.</p></div>
        <div><div class="n">03</div><h3>Tools, not just words</h3><p>Calculators built from real specs turn "which sauna?" into a number, not a guess.</p></div>
      </div>
    </section>

    <section class="faq home-faq" aria-label="Frequently asked questions">
      <h2 class="section-title">Infrared sauna FAQ</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><div>{f.a}</div></details>)}
    </section>
  </div>

  <StickyCta model={top} label={`#1 ${picks[0].label}`} showAfter={1400} />
</BaseLayout>
